<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Syed Sabair Hussain | IAM & Cybersecurity Professional</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<style>
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

:root {
  --primary: #00b4d8;
  --primary-dark: #0077b6;
  --accent: #90e0ef;
  --dark: #03051a;
  --dark2: #080d2a;
  --dark3: #0d1340;
  --card: #0a0f30;
  --text: #e0e8ff;
  --muted: #8892b0;
  --white: #ffffff;
  --font: 'Poppins', sans-serif;
  --mono: 'Fira Code', monospace;
}

html { scroll-behavior: smooth; }

body {
  font-family: var(--font);
  background: var(--dark);
  color: var(--text);
  overflow-x: hidden;
}

/* ========== SCROLLBAR ========== */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--dark2); }
::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 3px; }

/* ========== NAV ========== */
#navbar {
  position: fixed; top: 0; left: 0; right: 0; z-index: 999;
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem 4rem;
  background: rgba(3,5,26,0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(0,180,216,0.12);
  transition: padding 0.3s;
}
.nav-logo {
  font-family: var(--mono);
  font-size: 1.1rem;
  color: var(--primary);
  font-weight: 500;
  text-decoration: none;
}
.nav-logo span { color: var(--white); }
.nav-menu { display: flex; list-style: none; gap: 2rem; }
.nav-menu a {
  color: var(--muted);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  letter-spacing: 0.04em;
  transition: color 0.2s;
  position: relative;
  padding-bottom: 4px;
}
.nav-menu a::after {
  content: '';
  position: absolute; bottom: 0; left: 0;
  width: 0; height: 2px;
  background: var(--primary);
  transition: width 0.3s;
}
.nav-menu a:hover { color: var(--primary); }
.nav-menu a:hover::after { width: 100%; }
.nav-toggle { display: none; color: var(--primary); font-size: 1.4rem; cursor: pointer; }

/* ========== HERO ========== */
#home {
  min-height: 100vh;
  display: flex; align-items: center;
  padding: 0 4rem;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, var(--dark) 0%, var(--dark2) 60%, var(--dark3) 100%);
}

/* animated bg dots */
#home::before {
  content: '';
  position: absolute; inset: 0;
  background-image: radial-gradient(rgba(0,180,216,0.12) 1px, transparent 1px);
  background-size: 40px 40px;
  animation: bgMove 20s linear infinite;
}
@keyframes bgMove { from { background-position: 0 0; } to { background-position: 40px 40px; } }

.hero-inner {
  display: flex; align-items: center; justify-content: space-between;
  width: 100%; max-width: 1100px; margin: 0 auto;
  position: relative; z-index: 1;
  gap: 3rem;
}

.hero-left { flex: 1; }

.hero-greeting {
  font-family: var(--mono);
  font-size: 14px;
  color: var(--primary);
  margin-bottom: 0.5rem;
  letter-spacing: 0.1em;
}

.hero-left h1 {
  font-size: clamp(2.2rem, 5vw, 3.8rem);
  font-weight: 800;
  line-height: 1.1;
  margin-bottom: 0.4rem;
}

.hero-left h1 .name-highlight { color: var(--primary); }

.hero-typed-wrap {
  font-size: clamp(1.1rem, 2.5vw, 1.5rem);
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 1.5rem;
  min-height: 2rem;
}
.typed-cursor {
  color: var(--primary);
  animation: blink 0.7s infinite;
}
@keyframes blink { 0%,100% { opacity:1; } 50% { opacity:0; } }

.hero-desc {
  font-size: 15px;
  color: var(--muted);
  line-height: 1.8;
  max-width: 500px;
  margin-bottom: 2rem;
}

.hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem; }

.btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 0.75rem 1.8rem;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.25s;
  letter-spacing: 0.02em;
}
.btn-fill {
  background: var(--primary);
  color: #000;
}
.btn-fill:hover { background: var(--accent); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,180,216,0.3); }
.btn-outline {
  border: 2px solid var(--primary);
  color: var(--primary);
  background: transparent;
}
.btn-outline:hover { background: var(--primary); color: #000; transform: translateY(-2px); }

.hero-socials { display: flex; gap: 1rem; }
.hero-socials a {
  width: 40px; height: 40px;
  border: 1px solid rgba(0,180,216,0.3);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: var(--muted);
  font-size: 15px;
  text-decoration: none;
  transition: all 0.2s;
}
.hero-socials a:hover {
  border-color: var(--primary);
  color: var(--primary);
  background: rgba(0,180,216,0.08);
  transform: translateY(-2px);
}

/* Hero photo */
.hero-right {
  flex-shrink: 0;
  position: relative;
}
.hero-photo-wrap {
  width: 280px; height: 280px;
  border-radius: 50%;
  position: relative;
}
.hero-photo-wrap::before {
  content: '';
  position: absolute; inset: -4px;
  border-radius: 50%;
  background: conic-gradient(var(--primary), var(--primary-dark), var(--primary));
  animation: rotate 4s linear infinite;
  z-index: 0;
}
@keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.hero-photo-inner {
  position: relative; z-index: 1;
  width: 100%; height: 100%;
  border-radius: 50%;
  background: var(--dark3);
  border: 4px solid var(--dark);
  overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.hero-photo-inner img {
  width: 100%; height: 100%; object-fit: cover;
}
.photo-placeholder {
  font-size: 6rem;
  color: var(--primary);
  opacity: 0.5;
}

/* floating badges */
.hero-badge {
  position: absolute;
  background: var(--card);
  border: 1px solid rgba(0,180,216,0.25);
  border-radius: 10px;
  padding: 0.5rem 0.9rem;
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  display: flex; align-items: center; gap: 6px;
  animation: float 3s ease-in-out infinite;
  white-space: nowrap;
}
.hero-badge i { color: var(--primary); }
.badge-1 { top: 5%; right: -30px; animation-delay: 0s; }
.badge-2 { bottom: 12%; left: -40px; animation-delay: 1.5s; }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

/* ========== SECTION BASE ========== */
section { padding: 6rem 4rem; }
.section-label {
  font-family: var(--mono);
  font-size: 13px;
  color: var(--primary);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}
.section-title {
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  font-weight: 700;
  margin-bottom: 0.5rem;
}
.section-title span { color: var(--primary); }
.divider {
  width: 60px; height: 3px;
  background: var(--primary);
  border-radius: 2px;
  margin-bottom: 3rem;
}

.container { max-width: 1100px; margin: 0 auto; }

/* ========== ABOUT ========== */
#about { background: var(--dark2); }

.about-grid {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 4rem;
  align-items: start;
}

.about-card {
  background: var(--card);
  border: 1px solid rgba(0,180,216,0.12);
  border-radius: 16px;
  padding: 2rem;
}
.about-card-photo {
  width: 100px; height: 100px;
  border-radius: 50%;
  background: var(--dark3);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 1.2rem;
  border: 3px solid var(--primary);
  overflow: hidden;
}
.about-card-photo img { width: 100%; height: 100%; object-fit: cover; }
.about-card-photo i { font-size: 3rem; color: var(--primary); opacity: 0.5; }
.about-card h3 {
  text-align: center;
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 0.2rem;
}
.about-card-role {
  text-align: center;
  font-size: 13px;
  color: var(--primary);
  margin-bottom: 1.5rem;
  font-weight: 500;
}
.about-info-list { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; }
.about-info-list li {
  display: flex; align-items: flex-start; gap: 0.75rem;
  font-size: 13px;
  color: var(--muted);
}
.about-info-list li i { color: var(--primary); margin-top: 2px; width: 14px; flex-shrink: 0; }
.about-info-list li strong { color: var(--text); }

.about-right p {
  color: var(--muted);
  font-size: 15px;
  line-height: 1.8;
  margin-bottom: 1rem;
}

.skills-inline { margin-top: 1.5rem; }
.skills-inline h4 {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 0.75rem;
}
.tag-cloud { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.tag {
  background: rgba(0,180,216,0.08);
  border: 1px solid rgba(0,180,216,0.2);
  color: var(--primary);
  font-size: 12px;
  font-weight: 500;
  padding: 4px 12px;
  border-radius: 20px;
  font-family: var(--mono);
}

/* ========== RESUME ========== */
#resume { background: var(--dark); }

.resume-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
}

.resume-col-title {
  display: flex; align-items: center; gap: 0.75rem;
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 2rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid rgba(0,180,216,0.15);
}
.resume-col-title i { color: var(--primary); }

.timeline-item {
  position: relative;
  padding-left: 1.5rem;
  padding-bottom: 2rem;
  border-left: 2px solid rgba(0,180,216,0.2);
}
.timeline-item::before {
  content: '';
  position: absolute;
  left: -6px; top: 5px;
  width: 10px; height: 10px;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 0 10px rgba(0,180,216,0.5);
}
.timeline-date {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--primary);
  font-weight: 500;
  letter-spacing: 0.06em;
  margin-bottom: 0.3rem;
}
.timeline-title {
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 0.2rem;
}
.timeline-org {
  font-size: 13px;
  color: var(--muted);
  margin-bottom: 0.75rem;
  font-weight: 500;
}
.timeline-points {
  list-style: none;
  display: flex; flex-direction: column; gap: 0.4rem;
}
.timeline-points li {
  font-size: 13px;
  color: var(--muted);
  padding-left: 1rem;
  position: relative;
  line-height: 1.6;
}
.timeline-points li::before {
  content: '▸';
  position: absolute; left: 0;
  color: var(--primary);
  font-size: 10px;
  top: 3px;
}

/* ========== SKILLS SECTION ========== */
#skills { background: var(--dark2); }

.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
}

.skill-card {
  background: var(--card);
  border: 1px solid rgba(0,180,216,0.1);
  border-radius: 12px;
  padding: 1.5rem;
  transition: border-color 0.2s, transform 0.2s;
}
.skill-card:hover {
  border-color: rgba(0,180,216,0.35);
  transform: translateY(-3px);
}
.skill-card-head {
  display: flex; align-items: center; gap: 0.75rem;
  margin-bottom: 1.2rem;
}
.skill-card-head i {
  font-size: 1.4rem;
  color: var(--primary);
  width: 32px;
}
.skill-card-head h4 {
  font-size: 14px;
  font-weight: 700;
  color: var(--text);
}
.skill-bars { display: flex; flex-direction: column; gap: 0.75rem; }
.skill-bar-item {}
.skill-bar-label {
  display: flex; justify-content: space-between;
  font-size: 12px;
  color: var(--muted);
  margin-bottom: 4px;
}
.skill-bar-label span:last-child { color: var(--primary); font-weight: 600; }
.bar-track {
  height: 5px;
  background: rgba(255,255,255,0.06);
  border-radius: 3px;
  overflow: hidden;
}
.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-dark), var(--primary));
  border-radius: 3px;
  transform-origin: left;
  animation: growBar 1.2s ease-out forwards;
  transform: scaleX(0);
}
@keyframes growBar { to { transform: scaleX(1); } }

/* ========== PROJECTS ========== */
#projects { background: var(--dark); }

.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 1.5rem;
}

.project-card {
  background: var(--card);
  border: 1px solid rgba(0,180,216,0.1);
  border-radius: 14px;
  overflow: hidden;
  transition: border-color 0.2s, transform 0.2s;
  display: flex; flex-direction: column;
}
.project-card:hover {
  border-color: rgba(0,180,216,0.35);
  transform: translateY(-4px);
}
.project-card-top {
  padding: 1.5rem 1.5rem 1rem;
  border-bottom: 1px solid rgba(0,180,216,0.08);
  display: flex; align-items: flex-start; gap: 1rem;
}
.project-icon {
  width: 44px; height: 44px;
  border-radius: 10px;
  background: rgba(0,180,216,0.1);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.3rem;
  color: var(--primary);
  flex-shrink: 0;
}
.project-card-title { font-size: 1rem; font-weight: 700; margin-bottom: 0.2rem; }
.project-card-period {
  font-family: var(--mono);
  font-size: 10px;
  color: var(--primary);
  letter-spacing: 0.06em;
}
.project-card-body { padding: 1rem 1.5rem; flex: 1; }
.project-card-body p {
  font-size: 13px;
  color: var(--muted);
  line-height: 1.7;
}
.project-card-foot {
  padding: 1rem 1.5rem;
  display: flex; flex-wrap: wrap; gap: 0.4rem;
}
.proj-tag {
  font-size: 11px;
  font-family: var(--mono);
  color: var(--primary);
  background: rgba(0,180,216,0.08);
  border: 1px solid rgba(0,180,216,0.18);
  border-radius: 20px;
  padding: 2px 10px;
}

/* ========== CONTACT ========== */
#contact { background: var(--dark2); }

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
}

.contact-info-card {
  background: var(--card);
  border: 1px solid rgba(0,180,216,0.12);
  border-radius: 14px;
  padding: 2rem;
}
.contact-info-card h3 {
  font-size: 1.1rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}
.contact-info-card p {
  font-size: 14px;
  color: var(--muted);
  line-height: 1.7;
  margin-bottom: 2rem;
}
.contact-items { display: flex; flex-direction: column; gap: 1rem; }
.contact-item {
  display: flex; align-items: center; gap: 1rem;
}
.contact-item-icon {
  width: 44px; height: 44px;
  border-radius: 10px;
  background: rgba(0,180,216,0.08);
  border: 1px solid rgba(0,180,216,0.2);
  display: flex; align-items: center; justify-content: center;
  color: var(--primary);
  font-size: 1rem;
  flex-shrink: 0;
}
.contact-item-label {
  font-size: 11px;
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-family: var(--mono);
}
.contact-item-value {
  font-size: 14px;
  color: var(--text);
  font-weight: 500;
  text-decoration: none;
}
.contact-item-value:hover { color: var(--primary); }

.contact-socials {
  display: flex; gap: 0.75rem;
  margin-top: 2rem;
}
.contact-social-btn {
  width: 44px; height: 44px;
  border-radius: 10px;
  border: 1px solid rgba(0,180,216,0.2);
  display: flex; align-items: center; justify-content: center;
  color: var(--muted);
  font-size: 1rem;
  text-decoration: none;
  transition: all 0.2s;
}
.contact-social-btn:hover {
  background: var(--primary);
  border-color: var(--primary);
  color: #000;
  transform: translateY(-2px);
}

/* CONTACT FORM */
.contact-form { display: flex; flex-direction: column; gap: 1rem; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.form-group { display: flex; flex-direction: column; gap: 0.4rem; }
.form-group label { font-size: 12px; color: var(--muted); font-family: var(--mono); letter-spacing: 0.06em; }
.form-group input,
.form-group textarea {
  background: var(--card);
  border: 1px solid rgba(0,180,216,0.15);
  border-radius: 8px;
  padding: 0.75rem 1rem;
  color: var(--text);
  font-family: var(--font);
  font-size: 14px;
  outline: none;
  transition: border-color 0.2s;
  resize: none;
}
.form-group input:focus,
.form-group textarea:focus { border-color: var(--primary); }
.form-group input::placeholder,
.form-group textarea::placeholder { color: rgba(136,146,176,0.5); }
.btn-submit {
  background: var(--primary);
  color: #000;
  border: none;
  padding: 0.85rem 2rem;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 700;
  font-family: var(--font);
  cursor: pointer;
  display: flex; align-items: center; gap: 8px;
  width: fit-content;
  transition: background 0.2s, transform 0.2s;
}
.btn-submit:hover { background: var(--accent); transform: translateY(-2px); }

/* ========== FOOTER ========== */
footer {
  background: var(--dark);
  border-top: 1px solid rgba(0,180,216,0.1);
  padding: 2rem 4rem;
  display: flex; align-items: center; justify-content: space-between;
}
.footer-text {
  font-size: 13px;
  color: var(--muted);
  font-family: var(--mono);
}
.footer-text span { color: var(--primary); }
.footer-links { display: flex; gap: 1.5rem; }
.footer-links a {
  font-size: 12px;
  color: var(--muted);
  text-decoration: none;
  font-family: var(--mono);
  transition: color 0.2s;
}
.footer-links a:hover { color: var(--primary); }

/* ========== REVEAL ANIMATION ========== */
.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.reveal.visible { opacity: 1; transform: none; }
.reveal-delay-1 { transition-delay: 0.1s; }
.reveal-delay-2 { transition-delay: 0.2s; }
.reveal-delay-3 { transition-delay: 0.3s; }

/* ========== RESPONSIVE ========== */
@media (max-width: 900px) {
  #navbar { padding: 1rem 1.5rem; }
  .nav-menu { display: none; flex-direction: column; position: absolute; top: 100%; left: 0; right: 0; background: var(--dark2); padding: 1.5rem; gap: 1.2rem; border-bottom: 1px solid rgba(0,180,216,0.1); }
  .nav-menu.open { display: flex; }
  .nav-toggle { display: block; }
  section { padding: 4rem 1.5rem; }
  .hero-inner { flex-direction: column-reverse; text-align: center; }
  .hero-right { display: flex; justify-content: center; }
  .hero-photo-wrap { width: 200px; height: 200px; }
  .hero-btns { justify-content: center; }
  .hero-socials { justify-content: center; }
  .badge-1, .badge-2 { display: none; }
  .about-grid { grid-template-columns: 1fr; }
  .resume-grid { grid-template-columns: 1fr; }
  .contact-grid { grid-template-columns: 1fr; }
  .form-row { grid-template-columns: 1fr; }
  footer { flex-direction: column; gap: 1rem; text-align: center; padding: 1.5rem; }
}
</style>
</head>
<body>

<!-- NAV -->
<nav id="navbar">
  <a href="#home" class="nav-logo">&lt;<span>SSH</span> /&gt;</a>
  <span class="nav-toggle" onclick="toggleMenu()"><i class="fas fa-bars"></i></span>
  <ul class="nav-menu" id="nav-menu">
    <li><a href="#home" onclick="closeMenu()">Home</a></li>
    <li><a href="#about" onclick="closeMenu()">About</a></li>
    <li><a href="#resume" onclick="closeMenu()">Resume</a></li>
    <li><a href="#skills" onclick="closeMenu()">Skills</a></li>
    <li><a href="#projects" onclick="closeMenu()">Projects</a></li>
    <li><a href="#contact" onclick="closeMenu()">Contact</a></li>
  </ul>
</nav>

<!-- ========== HERO ========== -->
<section id="home">
  <div class="hero-inner">
    <div class="hero-left">
      <div class="hero-greeting">// Hello, World!</div>
      <h1>I am<br><span class="name-highlight">Syed Sabair Hussain</span></h1>
      <div class="hero-typed-wrap">
        <span id="typed-text"></span><span class="typed-cursor">|</span>
      </div>
      <p class="hero-desc">
        Cybersecurity professional with 5+ years of experience specializing in Identity & Access Management, governance, and security analytics — bridging technical IAM implementation with strategic security leadership.
